{
  "name": "axys",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "tsx server/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "preflight": "tsx scripts/providers-preflight.ts",
    "test:e2e": "playwright test",
    "lint": "prettier --check server packages services apps tests scripts *.ts",
    "format": "prettier --write server packages services apps tests scripts *.ts",
    "eval:preflight": "tsx eval/preflight-mutations.ts"
  },
  "dependencies": {
    "express": "5.1.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sharp": "0.35.5",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "5.0.3",
    "@types/node": "22.18.10",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
