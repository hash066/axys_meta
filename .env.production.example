# Copy to .env.production and fill in. Never commit the filled-in file.
# MODEL_API_KEY and DOMAIN go in a separate file named .env (see compose.yaml). AXYS_ORIGIN is derived from DOMAIN.

# --- Studio login (production accepts ONLY these; the local-demo key is disabled) ---
# Format: tenantId:sha256(accessKey)  (comma-separate for several workspaces). Generate with: node scripts/make-keys.mjs
AXYS_ACCESS_KEYS=

# --- Secrets generated by scripts/make-keys.mjs ---
AXYS_TOKEN_KEY=
AXYS_MEDIA_KEY=

# --- Product credits (Axys's own ledger units, not Meta API credits). Production default is 0. ---
AXYS_STARTER_CREDITS=20

# --- Instagram publishing (leave blank until you are ready; posting stays blocked) ---
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=
META_REDIRECT_URI=
META_INSIGHT_METRICS=
AXYS_ALLOW_PUBLIC_POSTING=false

# --- Optional: WhatsApp (not part of this deployment yet) ---
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_PUBLIC_NUMBER=
